import { Injectable, NotFoundException } from '@nestjs/common';
// import { BusinessMediaMongoRepository } from '../../infrastructure/repositories/business-media.mongo.repository';
import { CreateMediaDto } from '../dtos/create-media.dto';

@Injectable()
export class BusinessMediaService {
  constructor() {} // private readonly businessMediaRepository: BusinessMediaMongoRepository

  async createMedia(createMediaDto: CreateMediaDto, businessProfileId: string) {
    try {
      const { type, title, description, media } = createMediaDto;
      
      // Store each media file in GridFS
      const mediaUrls = await Promise.all(
        media.map(async (base64String: string) => {
          const buffer = Buffer.from(
            base64String.replace(/^data:.*?;base64,/, ''),
            'base64'
          );
          
          const filename = `${type}_${Date.now()}_${Math.random().toString(36).substring(7)}`;
          const contentType = type === 'video' ? 'video/mp4' : 'image/jpeg';
          
          return await this.businessMediaRepository.storeFile(buffer, filename, contentType);
        })
      );

      // Create media document
      return await this.businessMediaRepository.create({
        type,
        title,
        description,
        media: mediaUrls,
        businessProfileId,
      });
    } catch (error) {
      console.error('Error in createMedia:', error);
      throw error;
    }
  }

  async getMediaByType(type: string, businessProfileId: string) {
    const media = await this.businessMediaRepository.findByType(type as any, businessProfileId);

    // Convert GridFS IDs to downloadable URLs
    return media.map(item => ({
      ...item,
      media: item.media.map(mediaId => `/api/business/media/file/${mediaId}`),
    }));
  }

  async getMediaFile(fileId: string) {
    return await this.businessMediaRepository.getFileStream(fileId);
  }

  async deleteMedia(id: string, businessProfileId: string): Promise<void> {
    const media = await this.businessMediaRepository.findById(id);
    if (!media || media.businessProfileId !== businessProfileId) {
      throw new NotFoundException('Media not found');
    }

    // Delete files from GridFS
    await Promise.all(
      media.media.map(mediaId => this.businessMediaRepository.deleteFile(mediaId))
    );

    // Delete the document
    await this.businessMediaRepository.delete(id);
  }
}